def print_manifest(m: dict) -> None:
    hdr("artifacts under test")
    header = m.get("bit_header", {})
    info(f"bit    {m['bit']}")
    info(f"       from {m['bit_source']}  sha {m['bit_sha256']}")
    if header:
        info(f"       design={header.get('design','?')} part={header.get('part','?')} "
             f"built {header.get('date','?')} {header.get('time','?')}")
    info(f"xsa    {m.get('xsa') or '(none)'}")
    info(f"elf    {m.get('elf') or '(none)'}")
    if m.get("coherent") is True:
        ok("bitstream matches the hardware handoff the ELF was built against")
    elif m.get("coherent") is False:
        bad("bitstream / XSA mismatch")
    for note in m.get("notes", []):
        info(note)
    for w in m.get("warnings", []):
        warn(w)


def _prepare_remote(ssh: "Ssh", cfg: dict) -> None:
    with open(REMOTE_AGENT, "rb") as fh:
        agent_src = fh.read()
    ssh.run(f"mkdir -p $(dirname ~/{REMOTE_AGENT_PATH}) && cat > ~/{REMOTE_AGENT_PATH}",
            stdin_data=agent_src)


def _discover(ssh: "Ssh", cfg: dict, project: str) -> dict:
    return remote_json(ssh.run(
        f"{cfg['remote']['python']} ~/{REMOTE_AGENT_PATH} discover --project {rquote(project)}"))


def _needs_build(manifest: dict) -> list:
    reasons = []
    if not manifest.get("ok"):
        reasons.append("no bitstream found")
        return reasons
    if manifest.get("coherent") is False:
        reasons.append("bitstream does not match the XSA")
    if manifest.get("stale_sources"):
        reasons.append(f"{len(manifest['stale_sources'])} source file(s) newer "
                       "than the bitstream")
    return reasons


def cmd_build(args, cfg, _cfg_path) -> int:
    host = args.host or cfg["remote"]["host"]
    project = args.project or cfg["remote"]["project"]
    if not project:
        bad("no project directory: pass one or set remote.project in the config")
        return 2
    runlog = RunLog(cfg["log"]["dir"], project, int(cfg["log"]["keep"]))
    info(f"logs: {runlog.dir}")

    ssh = Ssh(host)
    try:
        ssh.connect()
        _prepare_remote(ssh, cfg)
        hdr("build")
        okay = do_build(ssh, cfg, project, runlog,
                        force=args.force, verbose=args.verbose)
        if okay:
            manifest = _discover(ssh, cfg, project)
            if manifest.get("ok"):
                print_manifest(manifest)
                runlog.write_json("manifest.json", manifest)
        return 0 if okay else 1
    except KeyboardInterrupt:
        return 130
    except Exception as exc:
        bad(str(exc))
        return 2
    finally:
        ssh.close()


def cmd_run(args, cfg, _cfg_path) -> int:
    import xvcd

    host = args.host or cfg["remote"]["host"]
    project = args.project or cfg["remote"]["project"]
    if not project:
        bad("no project directory: pass --project or set remote.project in the config")
        return 2

    runlog = RunLog(cfg["log"]["dir"], project, int(cfg["log"]["keep"]))
    info(f"logs: {runlog.dir}")

    spec = {
        "base": cfg["hw"].get("base", "0x0"),
        "tests": [t for t in cfg["tests"]
                  if not args.only or t.get("name") == args.only],
        "settle_ms": cfg["run"]["settle_ms"],
    }
    # A typo in --only used to filter every test out and then report a happy
    # "0 failed" after a full programming cycle. Refuse instead, and say what
    # the real names are so the typo is obvious.
    if args.only and not spec["tests"]:
        bad(f"--only {args.only!r} matched no test in {_cfg_path or 'the config'}")
        for t in cfg["tests"]:
            info(f"available: {t.get('name', '(unnamed)')!r}")
        return 2
    uart_tests = [t for t in spec["tests"]
                  if t.get("uart_expect") or t.get("uart_reject")]
    confirm_tests = [t for t in spec["tests"] if t.get("confirm")]

    # --- local cable, before anything slow happens ---------------------------
    hdr("local cable")
    local_port = _free_local_port()
    try:
        server = xvcd.serve(
            "127.0.0.1", local_port, cfg["cable"]["url"],
            float(cfg["cable"]["frequency_hz"]), int(cfg["cable"]["vector_bytes"]))
    except xvcd.CableError as exc:
        bad(str(exc))
        return 2
    ids = server.cable.scan_chain()
    for idcode in ids:
        ok(xvcd.describe_idcode(idcode))
    if not ids:
        bad("JTAG chain is empty; refusing to continue")
        return 2

    uart = None
    if cfg["uart"]["enabled"] and not args.no_uart:
        port = cfg["uart"]["port"] or UartCapture.autodetect()
        if port:
            try:
                uart = UartCapture(port, int(cfg["uart"]["baud"]))
                uart.start()
                ok(f"UART capture on {port} @ {cfg['uart']['baud']}")
            except Exception as exc:
                warn(f"UART capture unavailable ({exc})")
        elif uart_tests:
            warn("UART tests defined but no serial port found")

    ssh = Ssh(host)
    result = None
    try:
        hdr(f"remote: {host}")
        ssh.connect()
        remote_port = ssh.forward_remote(local_port)
        ok(f"reverse tunnel: {host}:{remote_port} -> localhost:{local_port}")
        _prepare_remote(ssh, cfg)
        ok(f"agent synced to ~/{REMOTE_AGENT_PATH}")

        manifest = _discover(ssh, cfg, project)
        reasons = _needs_build(manifest)

        # --- build if the artifacts are not current ------------------------
        want_build = args.build or (cfg["build"]["enabled"] and reasons
                                    and not args.no_build)
        if want_build:
            hdr("build")
            if args.build and not reasons:
                info("forced rebuild requested")
            for reason in reasons:
                info(f"needs build: {reason}")
            if not do_build(ssh, cfg, project, runlog,
                            force=args.build, verbose=args.verbose):
                return 4
            manifest = _discover(ssh, cfg, project)
            reasons = _needs_build(manifest)
        elif reasons and args.no_build:
            for reason in reasons:
                warn(f"{reason} (building disabled)")

        if not manifest.get("ok"):
            bad(manifest.get("error", "discovery failed"))
            return 2
        print_manifest(manifest)
        runlog.write_json("manifest.json", manifest)

        if reasons and not args.force:
            print()
            bad("refusing to program: " + "; ".join(reasons))
            info("let fpgatest build (drop --no-build), or pass --force")
            return 3

        # --- mode ----------------------------------------------------------
        mode = args.mode or cfg["run"].get("mode", "auto")
        if args.no_elf:
            mode = "bit"
        if mode == "auto":
            mode = "full" if manifest.get("elf") else "bit"
        spec["mode"] = mode

        # The quiet killer: in JTAG boot mode the BootROM runs no FSBL, so
        # FCLK_CLK0 is dead until ps7_init -- and ps7_init needs the XSA. With
        # no XSA the bitstream loads, DONE lights up, and the design sits
        # unclocked. That is indistinguishable from a broken design.
        if mode in ("bit", "full") and not manifest.get("xsa"):
            warn("no XSA found, so ps7_init cannot run and FCLK_CLK0 will not "
                 "start")
            info("if the PL is clocked from the PS, this will program cleanly "
                 "and then do nothing at all")
            info("fix: set build.export_xsa in the config, or run "
                 "write_hw_platform -fixed -include_bit in Vivado")

        if mode == "pl-only" and any(t.get("ops") for t in spec["tests"]):
            warn("pl-only skips ps7_init, so register tests are dropped "
                 "(no FCLK, no PS-PL access)")
            spec["tests"] = [t for t in spec["tests"] if not t.get("ops")]

        hdr(f"program and test  ({mode})")
        py, setup = cfg["remote"]["python"], cfg["remote"]["setup"]
        cmd = (f"{py} ~/{REMOTE_AGENT_PATH} run --project {rquote(project)} "
               f"--xvc-port {remote_port} "
               f"--manifest {shlex.quote(json.dumps(manifest))} "
               f"--spec {shlex.quote(json.dumps(spec))} "
               f"--timeout {cfg['run']['timeout_s']} "
               + (f"--setup {shlex.quote(setup)} " if setup else "")
               + "--emit-tcl ")
        # A bitstream download is the one step that can legitimately take
        # minutes, and a wedged one looks identical to a working one unless the
        # cable reports what it is doing.
        stop_monitor = threading.Event()

        def monitor() -> None:
            waited, last_bits = 0.0, 0
            while not stop_monitor.wait(5):
                waited += 5
                st = server.cable.stats
                if not st["shifts"]:
                    if waited >= 20:
                        print(f"  {C.DIM}·     hw_server has not opened the "
                              f"cable yet ({waited:.0f}s){C.RESET}")
                    continue
                bits, shifts = st["bits"], st["shifts"]
                rate = (bits - last_bits) / 5000.0
                last_bits = bits
                print(f"  {C.DIM}·     jtag {bits / 1e6:.2f} Mbit in {shifts} "
                      f"shifts ({bits // shifts // 1000} kbit each), "
                      f"{rate:.0f} kbit/s{C.RESET}")

        threading.Thread(target=monitor, daemon=True, name="xvc-monitor").start()
        try:
            proc = ssh.run(cmd, stream_stderr=True,
                           timeout=float(cfg["run"]["timeout_s"]) + 120)
        finally:
            stop_monitor.set()
        st = server.cable.stats
        if st["shifts"]:
            info(f"jtag total: {st['bits'] / 1e6:.2f} Mbit in {st['shifts']} "
                 f"shifts, {st['bits'] // st['shifts'] // 1000} kbit per shift")
        result = remote_json(proc)
    except KeyboardInterrupt:
        return 130
    except Exception as exc:
        bad(str(exc))
        return 2
    finally:
        ssh.close()

    if result:
        runlog.write_json("run.json", result)
        runlog.write("xsdb.log", result.get("xsdb_log"))
        runlog.write("hw_server.log", result.get("hw_server_log"))
        runlog.write("program.tcl", result.get("tcl"))

    if args.emit_tcl and result.get("tcl"):
        hdr("generated xsdb script")
        print(result["tcl"])

    if not result.get("ok"):
        bad(result.get("error", "remote run failed"))
        if result.get("hw_server_log"):
            print(result["hw_server_log"])
        server.shutdown()
        if uart:
            uart.stop()
        return 2

    # --- report ------------------------------------------------------------
    passed = failed = 0
    events = result["events"]
    reached_end = any(e["kind"] == "done" for e in events)
    programmed = any(e["kind"] == "step" and e["name"] == "program_pl"
                     and e["status"] == "ok" for e in events)
    for ev in events:
        kind, name, status, detail = (ev["kind"], ev["name"],
                                      ev["status"], ev["detail"])
        if kind == "testbegin":
            print(f"  {C.DIM}--- {name}{C.RESET}")
        elif kind == "step":
            (ok if status == "ok" else bad)(
                f"{name}" + (f"  {detail}" if status != "ok" else ""))
            failed += status != "ok"
        elif kind == "test":
            if status == "pass":
                ok(f"{name}  {detail}")
                passed += 1
            else:
                bad(f"{name}  {detail}")
                failed += 1

    if not reached_end:
        bad("the xsdb script stopped before it finished")
        failed += 1
    if not programmed:
        bad("the bitstream was never loaded")
        st = server.cable.stats
        if not st["connections"]:
            info("hw_server never opened the XVC cable at all, so it saw no "
                 "JTAG targets")
            info("that is the reverse tunnel or auto-open-servers, not the "
                 "board: `fpgatest doctor` now tests the tunnel end to end")
        elif st["shifts"] == 4:
            # 4 is exactly what our own start-up chain scan costs, so anything
            # more means hw_server did shift; anything equal means it did not.
            info(f"hw_server opened the cable {st['connections']}x but never "
                 "shifted a single bit")
            info("that usually means it rejected the advertised vector length")
        if st.get("trace"):
            hdr("xvc conversation")
            for line in st["trace"][:20]:
                print(f"  {C.DIM}{line}{C.RESET}")
        hdr("xsdb output")
        for line in (result.get("xsdb_log") or "").strip().splitlines()[-25:]:
            print(f"  {C.DIM}{line}{C.RESET}")
        hdr("hw_server output")
        for line in (result.get("hw_server_log") or "").strip().splitlines()[-25:]:
            print(f"  {C.DIM}{line}{C.RESET}")

    # Asking someone to eyeball a board that was never programmed is worse than
    # useless: it invites a "no" that looks like a design bug.
    if confirm_tests and not programmed:
        warn("skipping visual checks: nothing was programmed")
        confirm_tests = []

    if uart_tests and uart:
        hdr("uart assertions")
        time.sleep(float(cfg["uart"]["settle_s"]))
        for t in uart_tests:
            pattern = t.get("uart_expect") or t["uart_reject"]
            name = t.get("name", pattern)
            timeout = float(t.get("timeout_s", 10))
            seen = uart.wait_for(pattern, timeout)
            if t.get("uart_expect"):
                if seen:
                    ok(f"{name}  matched /{pattern}/")
                    passed += 1
                else:
                    bad(f"{name}  never saw /{pattern}/ in {timeout:g}s")
                    failed += 1
            else:
                if seen:
                    bad(f"{name}  saw forbidden /{pattern}/")
                    failed += 1
                else:
                    ok(f"{name}  /{pattern}/ absent")
                    passed += 1

    # Some faults are invisible to both AXI and UART. A mirrored segment map
    # reads back a perfectly correct result register while the display shows
    # the wrong digits; a missing pipeline pragma shows up only as flicker.
    # For those, the only instrument is a person looking at the board.
    if confirm_tests:
        hdr("visual confirmation")
        if args.no_confirm or not sys.stdin.isatty():
            for t in confirm_tests:
                warn(f"skipped (not interactive): {t['confirm']}")
        else:
            for t in confirm_tests:
                name = t.get("name", t["confirm"])
                try:
                    answer = input(f"  {C.BOLD}?{C.RESET}     {t['confirm']} [y/n/s] ")
                except EOFError:
                    answer = "s"
                answer = answer.strip().lower()[:1]
                if answer == "y":
                    ok(name)
                    passed += 1
                elif answer == "s":
                    warn(f"{name}  skipped")
                else:
                    bad(name)
                    failed += 1

    if uart:
        text = uart.text()
        uart.stop()
        runlog.write("uart.log", text)
        if text.strip() and (args.show_uart or failed):
            hdr("uart output")
            for line in text.strip().splitlines()[-40:]:
                print(f"  {C.DIM}{line}{C.RESET}")
    server.shutdown()

    print()
    print(f"{C.DIM}logs: {runlog.dir}{C.RESET}")
    verdict = f"{C.GREEN}PASS{C.RESET}" if not failed else f"{C.RED}FAIL{C.RESET}"
    print(f"{verdict}  {passed} passed, {failed} failed")
    return 0 if not failed else 1


# -------------------------------------------------------------------------- main

def main() -> int:
    ap = argparse.ArgumentParser(
        prog="fpgatest",
        description="Test a remotely-built bitstream on a locally-attached FPGA.")
    ap.add_argument("-c", "--config", help="path to fpgatest.toml")
    sub = ap.add_subparsers(dest="cmd", required=True)

    d = sub.add_parser("doctor", help="check every link in the chain")
    d.set_defaults(func=cmd_doctor)

    s = sub.add_parser("scan", help="probe the JTAG chain and print IDCODEs")
    s.set_defaults(func=cmd_scan)

    b = sub.add_parser("build", help="build on the server if it is out of date")
    b.add_argument("project", nargs="?", help="remote project directory")
    b.add_argument("--host")
    b.add_argument("--force", action="store_true", help="rebuild even if current")
    b.add_argument("-v", "--verbose", action="store_true",
                   help="echo Vivado progress lines")
    b.set_defaults(func=cmd_build)

    r = sub.add_parser("run", help="build if needed, then program and test")
    r.add_argument("project", nargs="?", help="remote project directory")
    r.add_argument("--host")
    r.add_argument("--only", help="run a single named test")
    r.add_argument("--mode", choices=("auto", "pl-only", "bit", "full"),
                   help="pl-only: just `fpga -file`. bit: + ps7_init, no ELF. "
                        "full: + download and run the application.")
    r.add_argument("--no-elf", action="store_true",
                   help="shorthand for --mode bit")
    r.add_argument("--build", action="store_true",
                   help="rebuild on the server even if it looks current")
    r.add_argument("--no-build", action="store_true",
                   help="never build; fail if the artifacts are stale")
    r.add_argument("-v", "--verbose", action="store_true",
                   help="echo Vivado progress lines during a build")
    r.add_argument("--no-uart", action="store_true")
    r.add_argument("--no-confirm", action="store_true",
                   help="skip interactive visual checks")
    r.add_argument("--show-uart", action="store_true")
    r.add_argument("--emit-tcl", action="store_true",
                   help="print the generated xsdb script")
    r.add_argument("--force", action="store_true",
                   help="run even if the artifacts look stale or mismatched")
    r.set_defaults(func=cmd_run)

    args = ap.parse_args()
    cfg, cfg_path = load_config(args.config)
    if cfg_path:
        print(f"{C.DIM}config: {cfg_path}{C.RESET}")
    try:
        return args.func(args, cfg, cfg_path)
    except KeyboardInterrupt:
        print("\ninterrupted")
        return 130


if __name__ == "__main__":
    raise SystemExit(main())

def _reexec_into_venv() -> None:
    """Hop into ./.venv automatically.

    Homebrew's Python is externally managed (PEP 668), so the dependencies can
    only live in a virtualenv. Re-executing ourselves there means `./fpgatest`
    just works without anyone remembering to activate anything.

    The "am I already inside it?" test has to be sys.prefix. A virtualenv's
    bin/python3 is a symlink to the base interpreter, so comparing
    realpath(sys.executable) against it always matches and the jump never
    happens."""
    if os.environ.get("FPGATEST_NO_REEXEC"):
        return
    try:
        import pyftdi  # noqa: F401
        return
    except ImportError:
        pass
    venv = os.path.join(HERE, ".venv")
    venv_py = os.path.join(venv, "bin", "python3")
    if os.path.abspath(sys.prefix) == os.path.abspath(venv):
        return  # already here, and the dependency is genuinely missing
    if not os.path.exists(venv_py):
        return
    os.environ["FPGATEST_NO_REEXEC"] = "1"
    os.execv(venv_py, [venv_py, os.path.join(HERE, "fpgatest")] + sys.argv[1:])


_reexec_into_venv()

def rquote(path: str) -> str:
    """Quote a remote path, but leave a leading ~ for the shell to expand.

    shlex.quote would wrap the whole thing in single quotes and the tilde would
    arrive at the far end as a literal character."""
    if path == "~":
        return "~"
    if path.startswith("~/"):
        return "~/" + shlex.quote(path[2:])
    return shlex.quote(path)



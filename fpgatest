def _toml_load(fh):
    """Imported lazily so that `doctor`, `scan` and `--help` work on any
    Python, and only config parsing needs 3.11+ (or the tomli backport)."""
    try:
        import tomllib
    except ModuleNotFoundError:
        try:
            import tomli as tomllib
        except ModuleNotFoundError:
            sys.stderr.write(
                "reading fpgatest.toml needs Python 3.11+ "
                "(brew install python@3.12) or `pip install tomli`.\n")
            raise SystemExit(2)
    return tomllib.load(fh)


def load_config(explicit: str | None) -> tuple[dict, str | None]:
    path = explicit
    if not path:
        for d in (os.getcwd(), os.path.expanduser("~/.config/fpgatest")):
            for name in CONFIG_NAMES:
                cand = os.path.join(d, name)
                if os.path.isfile(cand):
                    path = cand
                    break
            if path:
                break
    cfg = {k: dict(v) for k, v in DEFAULTS.items()}
    cfg["tests"] = []
    if path:
        with open(path, "rb") as fh:
            loaded = _toml_load(fh)
        for section, values in loaded.items():
            if section == "test":
                cfg["tests"] = values if isinstance(values, list) else [values]
            elif isinstance(values, dict):
                cfg.setdefault(section, {}).update(values)
            else:
                cfg[section] = values
    return cfg, path


# --------------------------------------------------------------------------- ssh

@dataclass
class Ssh:
    host: str
    ctl: str = field(default_factory=lambda: os.path.join(
        tempfile.mkdtemp(prefix="fpgatest-"), "ctl"))
    _open: bool = False

    def connect(self) -> None:
        subprocess.run(
            ["ssh", "-M", "-S", self.ctl, "-o", "ControlPersist=120",
             "-o", "BatchMode=yes", "-fN", self.host],
            check=True)
        self._open = True

    def close(self) -> None:
        if self._open:
            subprocess.run(["ssh", "-S", self.ctl, "-O", "exit", self.host],
                           capture_output=True)
            self._open = False
        shutil.rmtree(os.path.dirname(self.ctl), ignore_errors=True)

    def run(self, cmd: str, stdin_data: bytes | None = None,
            stream_stderr: bool = False, timeout: float | None = None):
        """Run a command on the remote. With stream_stderr the agent's live
        progress reaches the terminal while stdout is still captured."""
        return subprocess.run(
            ["ssh", "-S", self.ctl, self.host, cmd],
            input=stdin_data,
            stdout=subprocess.PIPE,
            stderr=None if stream_stderr else subprocess.PIPE,
            timeout=timeout)

    def forward_remote(self, local_port: int) -> int:
        """Ask the master for a reverse tunnel on a server-chosen free port.

        Letting sshd pick the port matters on a shared machine: a hard-coded
        2542 collides the moment a second person runs this."""
        proc = subprocess.run(
            ["ssh", "-S", self.ctl, "-O", "forward",
             "-R", f"0:127.0.0.1:{local_port}", self.host],
            capture_output=True, text=True)
        text = (proc.stdout + proc.stderr).strip()
        match = re.search(r"\d+", text)
        if proc.returncode != 0 or not match:
            raise RuntimeError(f"reverse tunnel failed: {text or proc.returncode}")
        return int(match.group())


def remote_json(proc: subprocess.CompletedProcess) -> dict:
    for line in proc.stdout.decode(errors="replace").splitlines():
        if line.startswith(RESULT_MARKER):
            return json.loads(line[len(RESULT_MARKER):])
    tail = (proc.stderr or b"").decode(errors="replace")[-3000:]
    raise RuntimeError(
        "agent produced no result"
        + (f". stderr:\n{tail}" if tail else " (see the output above)"))


# -------------------------------------------------------------------- uart capture

class UartCapture:
    def __init__(self, port: str, baud: int):
        self.port, self.baud = port, baud
        self.buf = bytearray()
        self._stop = threading.Event()
        self._thread: threading.Thread | None = None
        self._ser = None

    @staticmethod
    def autodetect() -> str | None:
        ports = sorted(glob.glob("/dev/cu.usbserial-*"))
        # Digilent/Real Digital boards put JTAG on FT2232 channel A and the
        # UART on channel B, which macOS names with a trailing "B".
        for p in ports:
            if p.endswith("B"):
                return p
        return ports[-1] if ports else None

    def start(self) -> None:
        import serial  # pyserial
        self._ser = serial.Serial(self.port, self.baud, timeout=0.2)
        self._ser.reset_input_buffer()

        def pump():
            while not self._stop.is_set():
                try:
                    chunk = self._ser.read(4096)
                except Exception:
                    break
                if chunk:
                    self.buf += chunk

        self._thread = threading.Thread(target=pump, daemon=True)
        self._thread.start()

    def text(self) -> str:
        return self.buf.decode("utf-8", errors="replace")

    def wait_for(self, pattern: str, timeout: float) -> bool:
        rx = re.compile(pattern)
        deadline = time.time() + timeout
        while time.time() < deadline:
            if rx.search(self.text()):
                return True
            time.sleep(0.1)
        return False

    def stop(self) -> None:
        self._stop.set()
        if self._thread:
            self._thread.join(timeout=1)
        if self._ser:
            try:
                self._ser.close()
            except Exception:
                pass


# ------------------------------------------------------------------- run logs

class RunLog:
    """A timestamped directory on this machine holding everything about one run.

    Builds happen on a server we do not control and Vivado logs get overwritten
    by the next run, so anything we want to be able to look at afterwards has to
    be pulled back here while we still have it."""

    def __init__(self, base: str, project: str, keep: int = 50):
        base = os.path.expanduser(base)
        name = os.path.basename(str(project).rstrip("/")) or "run"
        stamp = time.strftime("%Y%m%d-%H%M%S")
        self.dir = os.path.join(base, f"{stamp}-{name}")
        os.makedirs(self.dir, exist_ok=True)
        link = os.path.join(base, "latest")
        try:
            if os.path.islink(link) or os.path.exists(link):
                os.remove(link)
            os.symlink(self.dir, link)
        except OSError:
            pass
        self._prune(base, keep)

    @staticmethod
    def _prune(base: str, keep: int) -> None:
        try:
            runs = sorted(d for d in os.listdir(base)
                          if os.path.isdir(os.path.join(base, d)) and d[0].isdigit())
        except OSError:
            return
        for old in runs[:max(0, len(runs) - keep)]:
            shutil.rmtree(os.path.join(base, old), ignore_errors=True)

    def path(self, name: str) -> str:
        return os.path.join(self.dir, name)

    def write(self, name: str, text: str) -> None:
        if text is None:
            return
        with open(self.path(name), "w") as fh:
            fh.write(text if isinstance(text, str) else json.dumps(text, indent=2))

    def write_json(self, name: str, obj) -> None:
        with open(self.path(name), "w") as fh:
            json.dump(obj, fh, indent=2, default=str)


# --------------------------------------------------------------------- building

# Vivado is extremely chatty. These are the lines worth interrupting the user
# for; everything else still lands in the local build.log.
VIVADO_LOUD = re.compile(
    r"^(ERROR|CRITICAL WARNING)\b|^Vivado.* is exiting|Abnormal program termination|"
    r"^\s*Failed to|out of memory", re.IGNORECASE)
VIVADO_PROGRESS = re.compile(
    r"^(Starting|Finished|Phase \d|Running|Command:)|"
    r"(synth_design|opt_design|place_design|phys_opt_design|route_design|"
    r"write_bitstream) (Start|Complete)", re.IGNORECASE)


def fmt_elapsed(seconds: float) -> str:
    m, s = divmod(int(seconds), 60)
    h, m = divmod(m, 60)
    return f"{h:d}:{m:02d}:{s:02d}" if h else f"{m:d}:{s:02d}"


def do_build(ssh: "Ssh", cfg: dict, project: str, runlog: RunLog,
             force: bool = False, verbose: bool = False) -> bool:
    """Start (or reattach to) a detached Vivado build and stream its log home.

    The build runs in its own session on the server, so losing the SSH
    connection -- or pressing Ctrl-C here -- does not kill it."""
    b = cfg["build"]
    opts = {
        "tcl_script": b.get("tcl_script") or "",
        "xpr": b.get("xpr") or "",
        "jobs": int(b.get("jobs") or 0),
        "simulation": bool(b.get("simulation", False)),
        "simulation_fatal": bool(b.get("simulation_fatal", False)),
        "export_xsa": b.get("export_xsa") or "",
        "force": bool(force),
    }
    py, setup = cfg["remote"]["python"], cfg["remote"]["setup"]
    agent = f"{py} ~/{REMOTE_AGENT_PATH}"
    setup_arg = f"--setup {shlex.quote(setup)} " if setup else ""

    started = remote_json(ssh.run(
        f"{agent} build-start --project {rquote(project)} {setup_arg}"
        f"--opts {shlex.quote(json.dumps(opts))}"))
    if not started.get("ok"):
        bad(started.get("error", "build could not be started"))
        return False

    if started.get("attached"):
        warn(f"a build is already running on the server "
             f"(pid {started['state']['pid']}, started "
             f"{started['state'].get('started_iso','?')}) -- attaching to it")
    else:
        info(f"vivado launched detached on {ssh.host} "
             f"(pid {started['state']['pid']})")
        info("safe to Ctrl-C: the build keeps going and `fpgatest build` reattaches")

    offset = 0
    t0 = time.time()
    last_beat = t0
    stage = "starting"
    failed_stage = None
    poll = float(b.get("poll_s", 3))
    log_fh = open(runlog.path("build.log"), "w")

    try:
        while True:
            st = remote_json(ssh.run(
                f"{agent} build-status --project {rquote(project)} --offset {offset}"))
            state = st.get("state") or {}
            chunk = st.get("chunk", "")
            offset = st.get("next_offset", offset)

            if chunk:
                log_fh.write(chunk)
                log_fh.flush()
                for line in chunk.splitlines():
                    if line.startswith(RESULT_MARKER):
                        continue
                    if line.startswith("##FPGATEST##"):
                        parts = line.split("|")[1:]
                        parts += ["-"] * (4 - len(parts))
                        kind, name, status, detail = parts[:4]
                        if kind == "plan":
                            (info if status == "up-to-date" else ok)(
                                f"{name}: {status}")
                        elif kind == "stage":
                            stage = name
                            if status == "start":
                                print(f"  {C.BLUE}>{C.RESET}     {name} running…")
                            elif status == "ok":
                                ok(f"{name}  ({fmt_elapsed(time.time() - t0)})")
                            elif status == "skip":
                                info(f"{name}: {detail}")
                            else:
                                bad(f"{name}  {detail}")
                                failed_stage = name
                        elif kind == "artifact":
                            info(f"{name} -> {status}")
                    elif VIVADO_LOUD.search(line):
                        bad(line.strip()[:200])
                    elif verbose and VIVADO_PROGRESS.search(line):
                        info(line.strip()[:160])
                last_beat = time.time()

            if not state:
                bad("build state disappeared on the server")
                return False

            if state.get("exit_code") is not None and not state.get("running"):
                break

            if time.time() - last_beat > 30:
                print(f"  {C.DIM}·     {stage} … {fmt_elapsed(time.time() - t0)}"
                      f"{C.RESET}", end="\r", flush=True)
                last_beat = time.time()
            time.sleep(poll)
    except KeyboardInterrupt:
        print()
        warn("detached from the build -- it is still running on the server")
        info(f"reattach with:  fpgatest build {project}")
        raise
    finally:
        log_fh.close()

    logs = remote_json(ssh.run(f"{agent} build-logs --project {rquote(project)}")).get("logs", {})
    for name, text in logs.items():
        runlog.write(name, text)

    rc = state.get("exit_code")
    if state.get("died"):
        bad("the build process vanished without an exit code "
            "(killed, out of memory, or the node went down)")
        return False
    if failed_stage or rc != 0:
        bad(f"build failed at {failed_stage or 'vivado'} (exit {rc})")
        info(f"full log: {runlog.path('vivado.log')}")
        return False

    ok(f"build complete in {fmt_elapsed(time.time() - t0)}")
    return True


# ------------------------------------------------------------------------ doctor

def cmd_doctor(args, cfg, _cfg_path) -> int:
    failures = 0

    hdr("local python")
    info(f"{sys.version.split()[0]} at {sys.executable}")
    for mod, pkg in (("pyftdi", "pyftdi"), ("serial", "pyserial"), ("usb", "pyusb")):
        try:
            __import__(mod)
            ok(f"{pkg} importable")
        except ImportError:
            bad(f"{pkg} missing -- pip install pyftdi pyserial pyusb")
            failures += 1

    hdr("ftdi cable")
    try:
        from pyftdi.ftdi import Ftdi
        devices = Ftdi.list_devices()
        if not devices:
            bad("no FTDI device enumerated -- is the board powered and plugged in?")
            failures += 1
        for desc, _ in devices:
            info(f"{desc.vid:04x}:{desc.pid:04x} sn={desc.sn} "
                 f"desc={desc.description!r} iface={desc.index}")
            ok("FTDI device present")
    except Exception as exc:
        bad(f"could not enumerate FTDI devices: {exc}")
        failures += 1

    hdr("jtag chain")
    try:
        import xvcd
        cable = xvcd.FtdiJtag(cfg["cable"]["url"], float(cfg["cable"]["frequency_hz"]))
        ids = cable.scan_chain()
        cable.close()
        if not ids:
            bad("TAP responded but no IDCODEs came back -- check the JTAG jumper "
                "(JP2 must not be forcing SD/QSPI-only boot) and cable wiring")
            failures += 1
        for idcode in ids:
            ok(xvcd.describe_idcode(idcode))
        if len(ids) == 1:
            warn("only one TAP visible; Zynq usually shows the ARM DAP *and* the "
                 "PL device. PS debug will not work in independent JTAG mode.")
    except Exception as exc:
        bad(f"JTAG probe failed: {exc}")
        if sys.platform == "darwin":
            info("macOS holds FTDI interfaces with its own driver. If the open "
                 "failed with a resource/claim error, try:")
            info("  sudo kextunload -b com.apple.driver.AppleUSBFTDI   (Intel)")
            info("  or disable the AppleUSBFTDI dext, then replug the board.")
            info("Note this also removes /dev/cu.usbserial-*, so UART tests will "
                 "need `uart.enabled = false`.")
        failures += 1

    hdr("uart")
    port = cfg["uart"]["port"] or UartCapture.autodetect()
    if port:
        ok(f"serial port {port}")
    else:
        warn("no /dev/cu.usbserial-* found; UART assertions will be skipped")

    hdr(f"remote host: {cfg['remote']['host']}")
    ssh = Ssh(cfg["remote"]["host"])
    try:
        ssh.connect()
        ok("ssh master established")
        setup = cfg["remote"]["setup"]
        # Newlines, not "; ": a multi-line remote.setup joined with semicolons
        # produces "...\n; for t in ..." which is a bash syntax error, and the
        # probe then silently returns nothing -- which used to read as a pass.
        probe = "\n".join(filter(None, [
            setup,
            'for t in vivado hw_server xsdb xsct; do '
            'printf "%s -> %s\\n" "$t" "$(command -v $t || echo MISSING)"; done',
            f'{cfg["remote"]["python"]} -c '
            '"import sys; print(\'python -> \' + sys.version.split()[0])"',
        ]))
        proc = ssh.run(probe)
        lines = [l for l in proc.stdout.decode(errors="replace").splitlines() if l.strip()]
        found = {}
        if not lines:
            bad("the remote probe produced no output at all")
            info("remote.setup is almost certainly not valid shell. stderr:")
            for line in proc.stderr.decode(errors="replace").splitlines()[:8]:
                info(f"  {line}")
            failures += 1
        for line in lines:
            tool = line.split(" -> ")[0].strip()
            found[tool] = "MISSING" not in line
            (bad if "MISSING" in line else ok)(line)

        if lines:
            if not found.get("vivado"):
                bad("vivado is not on PATH -- building is impossible")
                failures += 1
            if not found.get("hw_server"):
                bad("hw_server is not on PATH -- programming is impossible")
                failures += 1
            if not (found.get("xsdb") or found.get("xsct")):
                bad("neither xsdb nor xsct found: this looks like a Vivado-only "
                    "install. --mode pl-only will still program the PL, but "
                    "ps7_init and the register testbench both need Vitis.")
                failures += 1

        if cfg["remote"]["project"]:
            proc = ssh.run(f'test -d {rquote(cfg["remote"]["project"])} && echo yes')
            if b"yes" in proc.stdout:
                ok(f"project directory {cfg['remote']['project']}")
            else:
                bad(f"project directory not found: {cfg['remote']['project']}")
                failures += 1
        import socket as _socket

        listener = _socket.socket()
        listener.setsockopt(_socket.SOL_SOCKET, _socket.SO_REUSEADDR, 1)
        listener.bind(("127.0.0.1", 0))
        listener.listen(1)
        listener.settimeout(15)
        local = listener.getsockname()[1]
        remote_port = ssh.forward_remote(local)

        got = {}

        def _serve():
            try:
                conn, _ = listener.accept()
                got["data"] = conn.recv(16)
                conn.sendall(b"pong\n")
                conn.close()
            except Exception as exc:
                got["error"] = str(exc)

        t = threading.Thread(target=_serve, daemon=True)
        t.start()
        # bash's /dev/tcp is enough; nothing extra needs to exist on the server.
        probe = ssh.run(
            f"exec 3<>/dev/tcp/127.0.0.1/{remote_port} && "
            f"printf ping >&3 && head -c 4 <&3", timeout=25)
        t.join(timeout=20)
        listener.close()

        if got.get("data") == b"ping" and b"pong" in probe.stdout:
            ok(f"reverse tunnel carries data "
               f"({ssh.host}:{remote_port} -> localhost:{local})")
        else:
            bad("the reverse tunnel was allocated but no data crossed it")
            info("this is exactly what stops hw_server from opening the XVC "
                 "cable")
            info(f"sshd may have AllowTcpForwarding or GatewayPorts "
                 f"restrictions. remote said: "
                 f"{probe.stderr.decode(errors='replace').strip()[:200]!r}")
            failures += 1
    except Exception as exc:
        bad(f"remote check failed: {exc}")
        failures += 1
    finally:
        ssh.close()

    print()
    if failures:
        print(f"{C.RED}{failures} problem(s) found{C.RESET}")
    else:
        print(f"{C.GREEN}all checks passed{C.RESET}")
    return 1 if failures else 0


def _free_local_port() -> int:
    import socket
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


# -------------------------------------------------------------------------- scan

def cmd_scan(args, cfg, _cfg_path) -> int:
    import xvcd
    cable = xvcd.FtdiJtag(cfg["cable"]["url"], float(cfg["cable"]["frequency_hz"]))
    ids = cable.scan_chain()
    cable.close()
    if not ids:
        bad("empty JTAG chain")
        return 1
    for i, idcode in enumerate(ids):
        print(f"  tap{i}: {xvcd.describe_idcode(idcode)}")
    return 0


